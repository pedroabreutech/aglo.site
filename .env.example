# URL do aplicativo da web do Google Apps Script (termina em /exec)
APPS_SCRIPT_URL=
# Segredo gerado pela função configurar() do Apps Script
APPS_SCRIPT_SECRET=

# Usuário do Instagram exibido no site (sem @)
NEXT_PUBLIC_INSTAGRAM=aglo.ia
# E-mail de contato exibido na política de privacidade
NEXT_PUBLIC_EMAIL_CONTATO=
